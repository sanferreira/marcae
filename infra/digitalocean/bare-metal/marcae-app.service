[Unit]
Description=Marcae App Web
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/marcae
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=BASE_PATH=/
ExecStart=/usr/bin/node artifacts/mobile/server/serve.js
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
