# Dominios que vao apontar para a Droplet.
LANDING_DOMAIN=marcae.net
APP_DOMAIN=app.marcae.net

# Banco interno do docker-compose. Use senha forte, sem espacos.
POSTGRES_DB=marcae
POSTGRES_USER=marcae
POSTGRES_PASSWORD=troque-por-uma-senha-forte
DATABASE_URL=postgresql://marcae:troque-por-uma-senha-forte@postgres:5432/marcae

# Stripe: gere chaves novas antes da producao.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Opcional: link do WhatsApp/suporte usado na LP.
VITE_SUPPORT_URL=

LOG_LEVEL=info
